x-common: &common   # shared defaults, merged into each service below
  restart: unless-stopped
  logging:
    driver: json-file

services:
  web:
    <<: *common
    image: nginx:1.28
    ports:
      - "80:80"

  db:
    <<: *common    # the same defaults, on a line no edit should touch
    image: postgres:16
